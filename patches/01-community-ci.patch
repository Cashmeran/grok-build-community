new file mode 100644
index 0000000..ae2f174
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,126 @@
+name: CI
+
+on:
+  workflow_dispatch:
+  push:
+    tags:
+      - 'v*'
+  pull_request:
+    branches: [main, community]
+
+jobs:
+  # ── Phase 1: 全平台快速检查 ──
+  check:
+    strategy:
+      matrix:
+        os: [ubuntu-latest, macos-latest, windows-latest]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+
+      # sccache: 没改的 crate 直接复用缓存，第二次起快 3-5x
+      - uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: ci
+
+      - name: Install protoc (Linux)
+        if: runner.os == 'Linux'
+        run: sudo apt-get update && sudo apt-get install -y protobuf-compiler
+      - name: Install protoc (macOS)
+        if: runner.os == 'macOS'
+        run: brew install protobuf
+      - name: Install protoc (Windows)
+        if: runner.os == 'Windows'
+        run: |
+          Invoke-WebRequest -Uri https://github.com/protocolbuffers/protobuf/releases/download/v29.3/protoc-29.3-win64.zip -OutFile protoc.zip
+          Expand-Archive protoc.zip -DestinationPath protoc
+          echo "${{ github.workspace }}/protoc/bin" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
+
+      - name: cargo check (workspace)
+        run: cargo check --workspace
+
+      - name: cargo fmt
+        run: cargo fmt
+
+      - name: cargo clippy (Linux only)
+        if: runner.os == 'Linux'
+        run: cargo clippy --workspace -- -D warnings
+
+  # ── Phase 2: 测试（Linux only）──
+  test:
+    needs: check
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: ci
+
+      - name: Install protoc
+        run: sudo apt-get update && sudo apt-get install -y protobuf-compiler
+
+      - name: cargo test (workspace)
+        run: cargo test --workspace
+
+  # ── Phase 3: 发布构建（仅 tag 触发）──
+  release:
+    if: startsWith(github.ref, 'refs/tags/v')
+    needs: test
+    permissions:
+      contents: write
+    strategy:
+      matrix:
+        include:
+          - os: ubuntu-latest
+            artifact: grokce-linux
+            ext: tar.gz
+          - os: macos-latest
+            artifact: grokce-macos
+            ext: tar.gz
+          - os: windows-latest
+            artifact: grokce-windows
+            ext: zip
+    runs-on: ${{ matrix.os }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: ci
+
+      - name: Install protoc (Linux)
+        if: runner.os == 'Linux'
+        run: sudo apt-get update && sudo apt-get install -y protobuf-compiler
+      - name: Install protoc (macOS)
+        if: runner.os == 'macOS'
+        run: brew install protobuf
+      - name: Install protoc (Windows)
+        if: runner.os == 'Windows'
+        run: |
+          Invoke-WebRequest -Uri https://github.com/protocolbuffers/protobuf/releases/download/v29.3/protoc-29.3-win64.zip -OutFile protoc.zip
+          Expand-Archive protoc.zip -DestinationPath protoc
+          echo "${{ github.workspace }}/protoc/bin" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
+
+      - name: Build release
+        run: cargo build -p xai-grok-pager-bin --release
+
+      - name: Package (Windows)
+        if: runner.os == 'Windows'
+        run: |
+          mv target/release/xai-grok-pager.exe grokce.exe
+          7z a ${{ matrix.artifact }}.${{ matrix.ext }} grokce.exe
+
+      - name: Package (Linux/macOS)
+        if: runner.os != 'Windows'
+        run: |
+          mv target/release/xai-grok-pager grokce
+          tar -czf ${{ matrix.artifact }}.${{ matrix.ext }} grokce
+
+      - name: Upload to Release
+        uses: softprops/action-gh-release@v2
+        with:
+          files: ${{ matrix.artifact }}.${{ matrix.ext }}
