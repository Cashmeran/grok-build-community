-            if depth >= MAX_JSON_DEPTH {
-                return Value::String(format!("[array:{}]", items.len()));
-            }
-            items
-                .iter()
-                .take(MAX_COLLECTION_ITEMS)
-                .map(|v| reduce_json(v, depth + 1))
-                .collect()
-        }
-        Value::Object(map) => {
-            if depth >= MAX_JSON_DEPTH {
-                return Value::String(format!("{{object:{}}}", map.len()));
-            }
-            map.iter()
-                .take(MAX_COLLECTION_ITEMS)
-                .map(|(k, v)| (k.clone(), reduce_json(v, depth + 1)))
