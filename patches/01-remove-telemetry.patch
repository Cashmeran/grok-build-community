-/// user-influenced path/query can't export. Storage-*path* keys (`gcs_path`,
-/// `object_path`, `output_path`) are excluded — those paths are wanted.
-static URL_VALUED_KEYS: &[&str] = &["url", "endpoint", "gcs_url", "bucket_url"];
