-                .as_deref()
-                .and_then(env_bool)
-                .or_else(|| file.and_then(|f| f.log_user_prompts))
-                .unwrap_or(false),
-            log_tool_details: getenv("OTEL_LOG_TOOL_DETAILS")
-                .as_deref()
