-            include_version_on_metrics: getenv("OTEL_METRICS_INCLUDE_VERSION")
-                .as_deref()
-                .and_then(env_bool)
-                .unwrap_or(false),
-            client: ExternalClientInfo::default(),
-            internal_pipeline_consumed_otel_vars: false,
-            enabled_source,
-        })
-    }
-}
