-/// O(1) lookup view over [`ALLOWED_STRING_KEYS`].
-static ALLOWED_STRING_KEY_SET: LazyLock<HashSet<&'static str>> =
-    LazyLock::new(|| ALLOWED_STRING_KEYS.iter().copied().collect());
