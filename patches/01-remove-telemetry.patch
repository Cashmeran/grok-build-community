-            "OTEL_METRICS_EXPORTER",
-            file.and_then(|f| f.metrics_exporter.as_deref()),
-        );
-        let logs_exporter = select(
-            "OTEL_LOGS_EXPORTER",
-            file.and_then(|f| f.logs_exporter.as_deref()),
-        );
