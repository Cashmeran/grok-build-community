+        assert_eq!(r.value.unwrap(), 3.0);
+    }
+
+    #[tokio::test]
+    async fn median_test() {
+        let r = run("median([1, 3, 2, 5, 4])").await.unwrap();
+        assert_eq!(r.value.unwrap(), 3.0);
+    }
+
+    #[tokio::test]
+    async fn min_max_sum() {
+        assert_eq!(
+            run("min([5, 2, 9, 1, 7])").await.unwrap().value.unwrap(),
+            1.0
+        );
+        assert_eq!(
