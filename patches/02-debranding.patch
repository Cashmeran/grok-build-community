+        assert_eq!(minimal_api::commit_scan_cursor(&s), 0, "cursor holds");
+
+        // Retry pass succeeds and commits both.
+        let n = commit_leading_run(&mut s, false, |_, _| true);
+        assert_eq!(n, 2);
