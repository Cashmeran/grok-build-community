+    write_team_auth(&home, "team-007");
+
+    let wrote = xai_grok_shell::managed_config::sync()
+        .await
+        .expect("a mid-body drop must be retried on a fresh connection, then succeed");
+    assert!(wrote);
+    assert!(home.join("managed_config.toml").exists());
