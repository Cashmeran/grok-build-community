+#!/usr/bin/env python3
+"""Split full git diff into per-category patches, excluding Cargo.lock."""
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+PATCHES = ROOT / "patches"
+PATCHES.mkdir(exist_ok=True)
+
+import subprocess
+full_diff = subprocess.run(
+    ["git", "diff", "upstream/main", "--", "."],
+    capture_output=True, text=True, cwd=ROOT,
+).stdout
+
+# Split by file hunks
+hunks = {}
+current_file = None
+current_lines = []
+for line in full_diff.split("\n"):
+    if line.startswith("diff --git a/"):
+        if current_file:
+            hunks[current_file] = "\n".join(current_lines)
+        current_file = line.split(" b/")[0].replace("diff --git a/", "")
+        current_lines = [line]
+    elif current_file:
+        current_lines.append(line)
+if current_file:
+    hunks[current_file] = "\n".join(current_lines)
+
+def category(f):
+    if ".github/workflows/" in f or f in ("build.bat", "install.ps1", "install.sh", "rust-toolchain.toml", "clippy.toml"):
+        return "03-ci.patch"
+    if "templates/" in f:
+        return "04-prompt.patch"
+    if any(x in f for x in ["ce-tools/", "grok-tools/", "grok-tools-api/"]):
+        return "05-tools.patch"
+    return "02-debranding.patch"
+
+patches = {}
+for f, hunk in hunks.items():
+    if f == "Cargo.lock":
+        continue
+    cat = category(f)
+    patches.setdefault(cat, []).append(hunk)
+
+for name in ["02-debranding.patch", "03-ci.patch", "04-prompt.patch", "05-tools.patch"]:
+    if name in patches:
+        content = "\n".join(patches[name])
+        (PATCHES / name).write_text(content, encoding="utf-8", newline="\n")
+        n_files = len([l for l in content.split("\n") if l.startswith("diff --git")])
+        print(f"  {name}: {n_files} files, {len(content)//1024} KB")
+    else:
+        (PATCHES / name).write_text(f"# {name} — no changes.\n", encoding="utf-8")
+        print(f"  {name}: 0 files")
+
+print("Done.")
