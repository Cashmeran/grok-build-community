+        assert_eq!(r.value.unwrap(), 14.0);
+    }
+
+    #[tokio::test]
+    async fn trig() {
+        let r = run("sin(pi/2)").await.unwrap();
+        assert!(r.value.unwrap() > 0.99);
+    }
+
+    #[tokio::test]
+    async fn equality_true() {
