+        assert_eq!(
+            run("min([5, 2, 9, 1, 7])").await.unwrap().value.unwrap(),
+            1.0
+        );
+        assert_eq!(
+            run("max([5, 2, 9, 1, 7])").await.unwrap().value.unwrap(),
+            9.0
+        );
+        assert_eq!(
+            run("sum([1, 2, 3, 4, 5])").await.unwrap().value.unwrap(),
+            15.0
+        );
