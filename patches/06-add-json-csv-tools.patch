+    }
+
+    #[test]
+    fn tool_name() {
+        assert_eq!(xai_tool_runtime::Tool::id(&CsvOpsTool).as_str(), "csv_ops");
+    }
+}
+fn csv_err(s: &str) -> xai_tool_runtime::ToolError {
+    xai_tool_runtime::ToolError::execution(xai_tool_protocol::ToolId::new("csv_ops").expect("valid"), s.to_string())
+}
