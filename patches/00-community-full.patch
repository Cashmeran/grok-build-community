-// ─── Internals ─────────────────────────────────────────────────────────────
-
-#[derive(Clone, Debug)]
-struct Scrubber {
-    home_dir: Option<String>,
-    usernames: Vec<String>,
-}
-
-impl Scrubber {
-    fn from_env() -> Self {
