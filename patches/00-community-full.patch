+-impl DedicatedRuntime {
+-    fn new() -> Self {
+-        let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<RuntimeCommand>();
+-        std::thread::spawn(move || {
+-            let rt = tokio::runtime::Builder::new_current_thread()
+-                .enable_all()
