++        result: if last_type == "binding" {
++            "ok".into()
++        } else {
++            format_val(last_value)
++        },
++        value: if last_type == "binding" {
++            None
++        } else {
++            Some(last_value)
++        },
++        type_name: last_type.into(),
++        exact: false,
++    })
++}
