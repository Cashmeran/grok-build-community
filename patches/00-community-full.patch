-fn scrub_attributes(attrs: &mut Vec<KeyValue>) {
-    enforce_allowlist(attrs);
-    for kv in attrs.iter_mut() {
-        if URL_VALUED_KEYS.contains(&kv.key.as_str()) {
-            reduce_url_to_origin(&mut kv.value);
-        }
-        redact_value(&mut kv.value);
-    }
-}
