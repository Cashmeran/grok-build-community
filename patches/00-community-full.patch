-// ─── Host integration ─────────────────────────────────────────────────────
-
-/// Per-host config; everything that varies between binaries lives here.
-pub struct Config {
-    /// Sentry tag `client`, e.g. `"grok-pager"`.
-    pub client: &'static str,
