-        let mixpanel = if config.mixpanel_enabled {
-            config
-                .mixpanel_token
-                .as_ref()
-                .map(|token| Arc::new(Mixpanel::new(token.as_str())))
-        } else {
-            None
-        };
-        let deployment_id = deployment_key
-            .filter(|s| !s.is_empty())
