+-    fn drop(&mut self) {
+-        shutdown_otel();
+-    }
++    fn drop(&mut self) {}
+ }
+-/// Create an [`OtelGuard`] that flushes traces on drop.
+ pub fn otel_guard() -> OtelGuard {
+     OtelGuard
+ }
