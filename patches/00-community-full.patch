++impl xai_tool_runtime::Tool for JsonQueryTool {
++    type Args = JsonQueryInput;
++    type Output = JsonQueryOutput;
++
++    fn id(&self) -> xai_tool_protocol::ToolId {
++        xai_tool_protocol::ToolId::new("json_query").expect("valid")
