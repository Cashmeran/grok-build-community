++    async fn run(
++        &self,
++        _: xai_tool_runtime::ToolCallContext,
++        input: JsonQueryInput,
++    ) -> Result<JsonQueryOutput, xai_tool_runtime::ToolError> {
++        let err = |s: &str| {
++            xai_tool_runtime::ToolError::execution(
++                xai_tool_protocol::ToolId::new("json_query").expect("valid"),
++                s.to_string(),
++            )
++        };
