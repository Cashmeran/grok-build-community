+-        &self,
+-        batch: opentelemetry_sdk::logs::LogBatch<'_>,
+-    ) -> impl std::future::Future<Output = opentelemetry_sdk::error::OTelSdkResult> + Send {
+-        for (record, _scope) in batch.iter() {
+-            let attrs: Vec<String> = record
+-                .attributes_iter()
+-                .map(|(k, v)| format!("{}={v:?}", k.as_str()))
+-                .collect();
