+-    let records = col::log_records(&collected);
+-    let harness = col::find_event(&collected, "grok_code.session_start")
+-        .expect("session_start must be present");
+-    assert_eq!(harness.scope_name, "ai.xai.grok_code");
+-    assert_eq!(
