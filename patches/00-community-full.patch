+-    assert_eq!(
+-        harness.attrs.get("deployment.id").and_then(|v| v.as_str()),
+-        Some("deploy-eu")
+-    );
+-
+-    // ── Prompt gate ON: text present, secret still scrubbed ─────────────
+-    let prompt = col::find_event(&collected, "grok_code.user_prompt").expect("user_prompt present");
