-/// Default-deny: drop content-valued attributes whose key isn't allowlisted.
-fn enforce_allowlist(attrs: &mut Vec<KeyValue>) {
-    attrs.retain(|kv| {
-        !is_content_value(&kv.value) || ALLOWED_STRING_KEY_SET.contains(kv.key.as_str())
-    });
-}
