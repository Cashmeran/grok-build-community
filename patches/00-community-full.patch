+-fn attr_keys(event: &(String, Vec<(String, String)>)) -> Vec<&str> {
+-    event.1.iter().map(|(k, _)| k.as_str()).collect()
+-}
+-
+-fn attr(event: &(String, Vec<(String, String)>), key: &str) -> Option<String> {
+-    event
+-        .1
+-        .iter()
+-        .find(|(k, _)| k == key)
+-        .map(|(_, v)| v.clone())
+-}
