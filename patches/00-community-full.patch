+-    std::thread::sleep(std::time::Duration::from_millis(400));
+-    assert_eq!(
+-        collected.logs_len(),
+-        logs_before,
+-        "no exports after the remote kill switch"
+-    );
+-
+-    external::shutdown();
+-}
