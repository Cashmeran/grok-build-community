++    async fn run(
++        &self,
++        _: xai_tool_runtime::ToolCallContext,
++        input: JsonQueryInput,
++    ) -> Result<JsonQueryOutput, xai_tool_runtime::ToolError> {
++        let err = |s: &str| {
++            xai_tool_runtime::ToolError::execution(
++                xai_tool_protocol::ToolId::new("json_query").expect("valid"),
++                s.to_string(),
++            )
++        };
++
++        let root: Value = serde_json::from_str(&input.json).map_err(|_| err("invalid JSON"))?;
++        let target =
++            resolve_path(&root, input.path.as_deref().unwrap_or("")).unwrap_or(root.clone());
++
++        let result = match input.operation.as_str() {
++            "get" => serde_json::to_string_pretty(&target).unwrap_or_default(),
++            "keys" => match &target {
