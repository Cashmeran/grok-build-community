-
-        assert_no_action(agent.execute_modal_button_action(ButtonAction::UninstallSelectedPlugin));
-        match agent.handle_extensions_modal_key(&key(KeyCode::Char('y'))) {
-            InputOutcome::Action(Action::ExecutePluginsAction(
