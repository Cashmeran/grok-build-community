-                .find(|h| h.label == "cancel")
-                .expect("running turn must surface the cancel hint");
-            assert_eq!(
-                cancel.keys,
-                vec![expected],
-                "cancel hint key for esc_would_cancel_turn={esc_would_cancel_turn}"
-            );
-        }
-    }
