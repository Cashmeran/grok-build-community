-    /// Esc consumers — is pinned by `esc_would_cancel_turn_tests` in
-    /// `agent_view::input`.)
-    #[test]
-    fn running_turn_cancel_hint_key_tracks_esc_predicate() {
-        let prompt = PromptWidget::default();
