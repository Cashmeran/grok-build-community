-        json["facts"]["clipboard"]["fix"],
-        "grok wrap <ssh command> or /minimal"
-    );
-    assert_eq!(json["findings"][0]["id"], "clipboard.delivery-unverified");
-    assert_eq!(json["counts"]["issues"], 1);
-}
