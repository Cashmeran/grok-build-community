-    #[cfg(unix)]
-    fn pid_is_alive(pid: u32) -> bool {
-        // SAFETY: signal 0 performs an existence/permission check only.
-        let result = unsafe { libc::kill(pid as libc::pid_t, 0) };
-        result == 0 || io::Error::last_os_error().raw_os_error() == Some(libc::EPERM)
-    }
