-    #[test]
-    fn parse_mcp_servers_drops_transport_less_entry() {
-        let root = toml::from_str::<TomlValue>(
-            r#"
-[mcp_servers.github]
-enabled = false
-
-[mcp_servers.linear]
-command = "npx"
-args = ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
-"#,
