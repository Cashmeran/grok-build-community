-    #[test]
-    fn bash_command_gate_distinguishes_ask_provenance() {
-        let policy = CompiledPolicy::new(PermissionConfig::new(vec![
-            bash_rule(RuleAction::Ask, "git push*"),
-            bash_rule(RuleAction::Deny, "rm -rf*"),
-        ]));
