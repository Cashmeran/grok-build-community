-        let err = serde_json::from_str::<Wrapper>(r#"{"value":{}}"#).unwrap_err();
-        assert!(err.to_string().contains("expected a list of string ids"));
-        let ok: Wrapper = serde_json::from_str(r#"{}"#).unwrap();
-        assert!(ok.value.is_empty());
-    }
